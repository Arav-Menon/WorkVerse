# ══════════════════════════════════════════════════════════════
#  WorkVerse Production Environment
# ══════════════════════════════════════════════════════════════
#
#  Replace all <CHANGE_ME> values with real credentials.
#  This file is referenced by docker-compose.prod.yml
#
#  Usage:
#    cp .env.production .env.production.local
#    # Edit .env.production.local with real values
#    docker compose -f docker-compose.prod.yml --env-file .env.production.local pull
#    docker compose -f docker-compose.prod.yml --env-file .env.production.local up -d
#
# ══════════════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<CHANGE_ME>
POSTGRES_DB=postgres

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Auth / JWT ────────────────────────────────────────────────
JWT_SECRET=<CHANGE_ME>

# ── Cortex (Main API) ────────────────────────────────────────
PORT=3000
DATABASE_URL=postgresql://postgres:<CHANGE_ME>@postgres:5432/postgres
CORS_ORIGIN=https://<YOUR_DOMAIN>
CLERK_PUBLISHABLE_KEY=<CHANGE_ME>
CLERK_SECRET_KEY=<CHANGE_ME>
CLERK_WEBHOOK_SECRET=<CHANGE_ME>
OPENROUTER_API_KEY=<CHANGE_ME>
GITHUB_CLIENT_ID=<CHANGE_ME>
GITHUB_CLIENT_SECRET=<CHANGE_ME>
GITHUB_REDIRECT_URL=https://<YOUR_DOMAIN>/api/v1/auth/github/callback
GOOGLE_CLIENT_ID=<CHANGE_ME>
GOOGLE_CLIENT_SECRET=<CHANGE_ME>
GOOGLE_REDIRECT_URL=https://<YOUR_DOMAIN>/api/v1/auth/google/callback
NOTION_CLIENT_ID=<CHANGE_ME>
NOTION_CLIENT_SECRET=<CHANGE_ME>
NOTION_REDIRECT_URL=https://<YOUR_DOMAIN>/api/v1/auth/notion/callback
NOTION_AUTHORIZATION_URL=https://api.notion.com/v1/oauth/authorize
N8N_ENCRYPTION_KEY=<CHANGE_ME>

# ── Flux (WebSocket Gateway) ──────────────────────────────────
CORTEX_API_URL=http://cortex:3000/api/v1/ingest-prompt

# ── Synapse (Chat WebSocket) ─────────────────────────────────
SYNAPSE_PORT=8001

# ── Space (Arena WebSocket) ──────────────────────────────────
SPACE_PORT=8002

# ── Stream (MediaSoup SFU) ───────────────────────────────────
SERVER_PUBLIC_IP=<YOUR_SERVER_PUBLIC_IP>
PORT=3010

# ── Relay (WebRTC Signaling) ─────────────────────────────────
API_URL=http://stream:3010/api/v1

# ── n8n Worker ────────────────────────────────────────────────
N8N_API_KEY=<CHANGE_ME>
N8N_ENGINE_URL=http://n8n-engine:5678/api/v1/workflows

# ── Mail Forger (Email Worker) ────────────────────────────────
RESEND_API_KEY=<CHANGE_ME>
RESEND_FROM_EMAIL=noreply@<YOUR_DOMAIN>

# ── Frontend (Next.js) ───────────────────────────────────────
API_URL=http://cortex:3000
WS_URL=ws://flux:8080
RELAY_URL=ws://relay:8089
SPACE_WS_URL=ws://space:8002
SYNAPSE_WS_URL=ws://synapse:8001
NEXT_PUBLIC_API_URL=https://<YOUR_DOMAIN>

# ── Frontend Service URLs (NEXT_PUBLIC_* for client bundle) ───
NEXT_PUBLIC_CORTEX_URL=https://cortex-workverse.arav.space
NEXT_PUBLIC_FLUX_URL=wss://flux-workverse.arav.space
NEXT_PUBLIC_RELAY_URL=wss://relay-workverse.arav.space
NEXT_PUBLIC_SPACE_URL=wss://space-workverse.arav.space
NEXT_PUBLIC_SYNAPSE_URL=wss://synapse-workverse.arav.space
