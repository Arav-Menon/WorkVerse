# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env*.local          # never commit local overrides
!.env.production     # production URLs are safe to commit (NEXT_PUBLIC_* = public)

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
