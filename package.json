{
  "name": "workVerse",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "cd /apps/web & bun run dev ",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "vitest"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.0",
    "prettier": "^3.7.4",
    "supertest": "^7.2.2",
    "turbo": "^2.8.16",
    "typescript": "5.7.3",
    "vitest": "^4.1.7",
    "@repo/testing": "*"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/*/*"
  ],
  "dependencies": {
    "@repo/events": "*",
    "@repo/queue": "*",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "bullmq": "^5.78.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "ws": "^8.21.0"
  }
}
