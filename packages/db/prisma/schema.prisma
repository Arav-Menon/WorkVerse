generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkflowStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum WorkflowExecutor {
  N8N
  MCP
  HYBRID
}

enum TaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ChannelType {
  PUBLIC
  PRIVATE
  AI_AGENT
}

enum SenderType {
  USER
  AGENT
  SYSTEM
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  memberships OrganizationMember[]
  messages    Message[]

  channelmembers      ChannelMember[]
  organization        Organization[]
  workspace           Workspace[]
  organizationInvites OrganizationInvite[]
  chatMessages        ChatMessage[]
  spaces              Space[]
  n8nConnections      OrganizationN8nConnection[]
  createdWorkflows    Workflow[]
  dmConversations1    DirectMessageConversation[] @relation("DMUser1")
  dmConversations2    DirectMessageConversation[] @relation("DMUser2")
  sentDmMessages      DirectMessage[]
}

model Organization {
  id                  String                      @id @default(uuid())
  name                String
  slug                String                      @unique
  description         String?
  createdAt           DateTime                    @default(now())
  createdById         String
  createdBy           User                        @relation(fields: [createdById], references: [id])
  members             OrganizationMember[]
  workspaces          Workspace[]
  organizationInvites OrganizationInvite[]
  spaces              Space[]
  connections         OrganizationConnection[]
  n8nConnection       OrganizationN8nConnection?
  workflows           Workflow[]
  dmConversations     DirectMessageConversation[]
}

model OrganizationInvite {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  name           String
  role           OrganizationRole @default(MEMBER)
  token          String           @unique
  inviteLink     String           @unique
  createdById    String
  status         InviteStatus
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [createdById], references: [id])
  organization   Organization     @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, email])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationRole
  joinedAt       DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
}

model Workspace {
  id             String       @id @default(uuid())
  name           String       @unique
  slug           String       @unique
  description    String?
  organizationId String
  createdAt      DateTime     @default(now())
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  agents       Agent[]
  channels     Channel[]
  chatMessages ChatMessage[]
  spaces       Space[]
}

model WorkflowJob {
  id             String            @id
  workspaceId    String
  organizationId String
  createdById    String
  title          String
  prompt         String
  systemPrompt   String?
  status         WorkflowStatus
  executor       WorkflowExecutor?
  graph          Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  executions JobExecution[]
  events     AgentEvent[]
}

model AiChatMessage {
  id             String      @id
  conversationId String
  promptId       String
  organizationId String
  workspaceId    String
  userId         String
  role           MessageRole
  content        Json
  createdAt      DateTime
}

model JobExecution {
  id          String     @id @default(uuid())
  taskId      String
  workerId    String
  logs        String?
  input       Json
  output      Json
  status      TaskStatus
  startedAt   DateTime
  completedAt DateTime?

  task WorkflowJob @relation(fields: [taskId], references: [id])

  @@index([taskId])
}

model Agent {
  id           String   @id @default(uuid())
  workspaceId  String
  name         String
  model        String
  systemPrompt String
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  messages Message[]
}

