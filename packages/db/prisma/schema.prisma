model Tool {
  id          String   @id @default(uuid())
  name        String
  type        String
  endpoint    String
  description String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())

  capabilities ToolCapability[]
}

model ToolCapability {
  id          String  @id @default(uuid())
  toolId      String
  name        String
  description String?

  tool Tool @relation(fields: [toolId], references: [id])

  @@index([toolId])
}

model Channel {
  id          String      @id @default(uuid())
  workspaceId String
  name        String
  type        ChannelType
  createdAt   DateTime    @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  members  ChannelMember[]
  messages Message[]
}

model ChannelMember {
  id        String   @id @default(uuid())
  channelId String
  userId    String
  joinedAt  DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([channelId, userId])
}

model ChatMessage {
  id          String   @id @default(uuid())
  content     String
  workspaceId String
  userId      String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([workspaceId])
  @@index([userId])
}

model Message {
  id         String     @id @default(uuid())
  channelId  String
  senderType SenderType
  senderId   String
  content    String
  createdAt  DateTime   @default(now())
  channel    Channel    @relation(fields: [channelId], references: [id])
  user       User?      @relation(fields: [userId], references: [id])
  userId     String?
  agent      Agent?     @relation(fields: [agentId], references: [id])
  agentId    String?

  @@index([channelId])
}

model AgentEvent {
  id        String   @id @default(uuid())
  jobId     String
  taskId    String?
  type      String
  payload   Json?
  createdAt DateTime @default(now())

  job WorkflowJob @relation(fields: [jobId], references: [id])

  @@index([jobId])
}

enum ConnectionProvider {
  GITHUB
  GOOGLE
  SLACK
}

enum ConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

model OrganizationConnection {
  id                    String             @id @default(uuid())
  organizationId        String
  provider              ConnectionProvider
  providerAccountId     String?
  accessToken           String
  refreshToken          String?
  encryptedAccessToken  String             @default("")
  encryptedRefreshToken String?
  scopes                String?
  metadata              Json?
  status                ConnectionStatus   @default(ACTIVE)
  connectedAt           DateTime           @default(now())
  lastSyncedAt          DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId])
}

model OrganizationN8nConnection {
  id              String    @id @default(uuid())
  organizationId  String
  baseUrl         String
  encryptedApiKey String
  connectedById   String
  connectedBy     User      @relation(fields: [connectedById], references: [id])
  status          String    @default("CONNECTED")
  lastValidatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId])
  @@index([organizationId])
}

model Space {
  id          String       @id @default(uuid())
  name        String       @default("Main")
  orgId       String
  workspaceId String
  createdById String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User         @relation(fields: [userId], references: [id])
  userId      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([workspaceId])
  @@index([workspaceId])
  @@index([orgId])
}

model Workflow {
  id               String    @id @default(uuid())
  organizationId   String
  workspaceId      String
  createdById      String
  name             String
  description      String?
  prompt           String
  workflowPlan     Json?
  mappedWorkflow   Json?
  executionType    String    @default("N8N")
  status           String    @default("DRAFT")
  deploymentStatus String    @default("PENDING")
  integrations     String[]
  steps            Json?
  n8nWorkflowId    String?
  n8nWorkflowUrl   String?
  promptId         String    @unique
  version          Int       @default(1)
  lastExecutedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                @relation(fields: [createdById], references: [id])
  executions   WorkflowExecution[]

  @@index([organizationId])
  @@index([workspaceId])
  @@index([createdById])
  @@index([promptId])
}

model WorkflowExecution {
  id          String    @id @default(uuid())
  workflowId  String
  status      String    @default("RUNNING")
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  duration    Int?
  logs        String?
  error       String?
  triggerType String    @default("MANUAL")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}

model DirectMessageConversation {
  id             String   @id @default(uuid())
  organizationId String
  user1Id        String
  user2Id        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user1        User            @relation("DMUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2        User            @relation("DMUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages     DirectMessage[]

  @@unique([organizationId, user1Id, user2Id])
  @@index([organizationId])
  @@index([user1Id])
  @@index([user2Id])
}

model DirectMessage {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime @default(now())

  conversation DirectMessageConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}
