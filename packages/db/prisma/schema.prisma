model Tool {
  id          String   @id @default(uuid())
  name        String
  type        String
  endpoint    String
  description String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())

  capabilities ToolCapability[]
}

model ToolCapability {
  id          String  @id @default(uuid())
  toolId      String
  name        String
  description String?

  tool Tool @relation(fields: [toolId], references: [id])

  @@index([toolId])
}

model Channel {
  id          String      @id @default(uuid())
  workspaceId String
  name        String
  type        ChannelType
  createdAt   DateTime    @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  members  ChannelMember[]
  messages Message[]
}

model ChannelMember {
  id        String   @id @default(uuid())
  channelId String
  userId    String
  joinedAt  DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([channelId, userId])
}

model ChatMessage {
  id          String   @id @default(uuid())
  content     String
  workspaceId String
  userId      String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([workspaceId])
  @@index([userId])
}

model Message {
  id         String     @id @default(uuid())
  channelId  String
  senderType SenderType
  senderId   String
  content    String
  createdAt  DateTime   @default(now())
  channel    Channel    @relation(fields: [channelId], references: [id])
  user       User?      @relation(fields: [userId], references: [id])
  userId     String?
  agent      Agent?     @relation(fields: [agentId], references: [id])
  agentId    String?

  @@index([channelId])
}

model AgentEvent {
  id        String   @id @default(uuid())
  jobId     String
  taskId    String?
  type      String
  payload   Json?
  createdAt DateTime @default(now())

  job WorkflowJob @relation(fields: [jobId], references: [id])

  @@index([jobId])
}
